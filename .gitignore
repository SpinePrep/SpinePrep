# =============================================================================
# SpinePrep .gitignore - Optimized for medical imaging Python project
# =============================================================================

# -----------------------------------------------------------------------------
# Python bytecode & caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/

# -----------------------------------------------------------------------------
# Testing & coverage
# -----------------------------------------------------------------------------
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.tox/
.nox/

# -----------------------------------------------------------------------------
# Virtual environments
# -----------------------------------------------------------------------------
.venv/
venv/
ENV/
env/

# -----------------------------------------------------------------------------
# Build & distribution
# -----------------------------------------------------------------------------
dist/
build/
*.egg-info/
*.egg
*.whl
MANIFEST
pip-wheel-metadata/

# -----------------------------------------------------------------------------
# Editor / IDE
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# OS generated
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Project runtime / outputs (do not version large or write-once artifacts)
# -----------------------------------------------------------------------------
logs/
work/
state/
out_*/

# -----------------------------------------------------------------------------
# Local datasets / inputs (keep out of git)
# -----------------------------------------------------------------------------
datasets/

# -----------------------------------------------------------------------------
# Private folder (never commit)
# -----------------------------------------------------------------------------
private/

# -----------------------------------------------------------------------------
# Medical imaging / large binaries (avoid accidental commits)
# -----------------------------------------------------------------------------
*.nii
*.nii.gz
*.mgz
*.mgh
*.dcm
*.dicom
*.DICOM
*.par
*.rec
*.trk
*.tck
*.vtk

# -----------------------------------------------------------------------------
# Local large docs / exports
# -----------------------------------------------------------------------------
/os

# -----------------------------------------------------------------------------
# Debug & temporary files (root level)
# -----------------------------------------------------------------------------
*.log
debug_*.log
*.tmp
*.temp

# Temporary reproduction/debug scripts (root level only)
/reproduce_*.py
/rerun_*.py
/regenerate_*.py

# Temporary markdown notes
/s3_*.md
/debug_*.md

# -----------------------------------------------------------------------------
# Jupyter notebooks checkpoints
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Documentation build outputs
# -----------------------------------------------------------------------------
docs/_build/
site/

# -----------------------------------------------------------------------------
# Secrets & local config (never commit)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
secrets.yml

# -----------------------------------------------------------------------------
# Dev/debug artifacts
# -----------------------------------------------------------------------------
tmp/
tmp_test.mat
*.bak
mcflirt_help.txt
mcflirt_man.txt
current_sch2D_3dof.sch
sch2D_2dof.sch
test_sch2D_2dof.sch
test_flirt_params.py
test_flirt_speed.py
test_flirt_z_proj.py

# SCT straightening cache artifact (generated, never track)
straightening.cache
**/straightening.cache

# --- Kept local, NOT published (manuscript + publication strategy + internal
#     planning logs). Purged from public git history during the 2026 migration. ---
paper/
DONE.md
GOAL.md
HANDOFF.md
.claude/specs/publication-strategy.md
.claude/specs/v1-claims-ledger.md
.claude/specs/v1-publication-roadmap.md
.claude/specs/v2-finalization-plan.md
.claude/specs/v2-highest-venue-claims.md

# Core dumps (never track)
core
core.*
*.core
vgcore.*

# Provisional analysis outputs -- regenerated by analysis/run_all.py on the corrected cohort
analysis/results/

# Claim-bearing ledgers live in paper/, which is a separate PRIVATE repository.
# These are symlinks into it. Tracking them here would publish the manuscript claims
# and the retraction record. See tests/test_paper_stays_private.py.
LEDGER_SOURCE.md
PROJECT_LEDGER.md
PROJECT_LEDGER.json
.ledger/
analysis/RETRACTION_AUDIT.md

# --- IDENTITY BOUNDARY -------------------------------------------------------
# This repository is the PUBLIC TOOLBOX, spineprep. The PAPER, p2-spineprep, is a
# separate private repository living at paper/. Paper-side trees are symlinks into
# it so every path still resolves; tracking them here would publish the manuscript,
# its findings and its strategy. Enforced by tests/test_identity_boundary.py.
# no trailing slash: these are SYMLINKS into paper/, and a directory
# pattern does not match a symlink.
analysis
exploration
private
research
.claude/specs/p2-*
.claude/specs/publication-*
.claude/specs/v1-claims-*
.claude/specs/v1-publication-*
.claude/specs/v2-*
AUDIT_candidates.md
CANDIDATES_100.md
CANDIDATES_raw_tool_output.md

# the agent contract is local only: it names the machine and unrelated projects (launch audit, 2026-09-20)
CLAUDE.md
