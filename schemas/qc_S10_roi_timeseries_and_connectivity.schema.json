{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qc_S10_roi_timeseries_and_connectivity.schema.json",
  "title": "S10_roi_timeseries_and_connectivity QC Status",
  "type": "object",
  "required": ["dataset_key", "step_code", "status", "runs"],
  "properties": {
    "dataset_key": { "type": "string" },
    "step_code": {
      "type": "string",
      "const": "S10_roi_timeseries_and_connectivity"
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL"]
    },
    "failure_message": { "type": ["string", "null"] },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status", "step_code", "dataset_key",
          "subject", "session", "run_id",
          "metrics", "failure_reasons", "reportlets"
        ],
        "properties": {
          "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
          "step_code": {
            "type": "string",
            "const": "S10_roi_timeseries_and_connectivity"
          },
          "dataset_key": { "type": "string" },
          "subject": { "type": ["string", "null"] },
          "session": { "type": ["string", "null"] },
          "run_id": { "type": ["string", "null"] },
          "metrics": {
            "type": "object",
            "properties": {
              "n_volumes": { "type": ["integer", "null"] },
              "n_rois_vertlvl": { "type": ["integer", "null"] },
              "n_rois_spinalseg": { "type": ["integer", "null"] },
              "n_rois_hemicord": { "type": ["integer", "null"] },
              "n_rois_dropped_low_voxels": { "type": ["integer", "null"] },
              "condition_number_pearson_hemicord": { "type": ["number", "null"] },
              "mean_within_segment_ventral_z": { "type": ["number", "null"] },
              "mean_within_segment_dorsal_z": { "type": ["number", "null"] },
              "mean_cross_hemicord_z": { "type": ["number", "null"] },
              "median_per_roi_tsnr_hemicord": { "type": ["number", "null"] }
            }
          },
          "failure_reasons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "failure_message": { "type": ["string", "null"] },
          "reportlets": {
            "type": "object",
            "properties": {
              "hemicord_timeseries": { "type": "string" },
              "hemicord_connectivity": { "type": "string" },
              "vertlvl_tsnr": { "type": "string" },
              "reliability_icc": { "type": "string" },
              "reliability_dice": { "type": "string" }
            }
          },
          "output_paths": {
            "type": "object",
            "properties": {
              "vertlvl_rawts_tsv":   { "type": "string" },
              "vertlvl_s8reg_tsv":   { "type": "string" },
              "spinalseg_rawts_tsv": { "type": "string" },
              "spinalseg_s8reg_tsv": { "type": "string" },
              "hemicord_rawts_tsv":  { "type": "string" },
              "hemicord_s8reg_tsv":  { "type": "string" },
              "hemicord_pearson_connectivity_tsv": { "type": "string" },
              "hemicord_fisherz_tsv":              { "type": "string" },
              "hemicord_partial_tsv":              { "type": "string" }
            }
          }
        }
      }
    },
    "subject_summaries": {
      "type": "array",
      "description": "Per-subject summaries with reliability when ≥2 sessions",
      "items": {
        "type": "object",
        "properties": {
          "subject": { "type": "string" },
          "n_sessions": { "type": "integer" },
          "reliability_computed": { "type": "boolean" },
          "icc_good_or_excellent_fraction": { "type": ["number", "null"] },
          "mean_spatial_dice": { "type": ["number", "null"] },
          "summary_json_path": { "type": "string" },
          "reliability_json_path": { "type": ["string", "null"] }
        }
      }
    }
  }
}
