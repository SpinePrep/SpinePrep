{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qc_S8_confounds.schema.json",
  "title": "S8_confounds_and_physio_regressors QC Status",
  "description": "QC status schema for S8 step (aggregated per dataset key)",
  "type": "object",
  "required": ["dataset_key", "step_code", "status", "runs"],
  "properties": {
    "dataset_key": { "type": "string" },
    "step_code": {
      "type": "string",
      "const": "S8_confounds_and_physio_regressors"
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL"]
    },
    "failure_message": { "type": ["string", "null"] },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status", "step_code", "dataset_key",
          "subject", "session", "run_id",
          "metrics", "failure_reasons", "reportlets"
        ],
        "properties": {
          "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
          "step_code": {
            "type": "string",
            "const": "S8_confounds_and_physio_regressors"
          },
          "dataset_key": { "type": "string" },
          "subject": { "type": ["string", "null"] },
          "session": { "type": ["string", "null"] },
          "run_id": { "type": ["string", "null"] },
          "physio_present": { "type": "boolean" },
          "spinalcompcor_enabled": { "type": "boolean" },
          "metrics": {
            "type": "object",
            "properties": {
              "n_volumes": { "type": ["integer", "null"] },
              "n_slices_with_csf": { "type": ["integer", "null"] },
              "n_columns_total": { "type": ["integer", "null"] },
              "n_columns_motion": { "type": ["integer", "null"] },
              "n_columns_csf": { "type": ["integer", "null"] },
              "n_columns_retroicor": { "type": ["integer", "null"] },
              "n_columns_cosine": { "type": ["integer", "null"] },
              "n_columns_spinalcompcor": { "type": ["integer", "null"] },
              "n_columns_outliers": { "type": ["integer", "null"] },
              "outlier_fraction": { "type": ["number", "null"] },
              "condition_number": { "type": ["number", "null"] },
              "fd_mean_mm": { "type": ["number", "null"] },
              "fd_max_mm": { "type": ["number", "null"] },
              "dvars_mean": { "type": ["number", "null"] },
              "cardiac_bpm_estimate": { "type": ["number", "null"] },
              "respiratory_cpm_estimate": { "type": ["number", "null"] },
              "spinalcompcor_median_pcs": { "type": ["number", "null"] }
            }
          },
          "failure_reasons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "failure_message": { "type": ["string", "null"] },
          "reportlets": {
            "type": "object",
            "required": [
              "confound_columns",
              "fd_dvars_outliers",
              "pnm_peaks",
              "correlation_heatmap"
            ],
            "properties": {
              "confound_columns": {
                "type": "string",
                "description": "Per-family regressor count bar chart with status pill"
              },
              "fd_dvars_outliers": {
                "type": "string",
                "description": "FD + DVARS + refRMS time series, outlier frames marked"
              },
              "pnm_peaks": {
                "type": "string",
                "description": "FSL popp cardiac peaks + respiratory phase; placeholder when physio absent"
              },
              "correlation_heatmap": {
                "type": "string",
                "description": "Pearson r matrix across confound columns (multicollinearity proxy)"
              }
            }
          },
          "confounds_paths": {
            "type": "object",
            "properties": {
              "tsv": { "type": "string" },
              "json": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
