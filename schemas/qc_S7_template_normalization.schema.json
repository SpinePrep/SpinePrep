{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qc_S7_template_normalization.schema.json",
  "title": "S7_template_normalization QC Status",
  "description": "QC status schema for S7_template_normalization step (aggregated per dataset key)",
  "type": "object",
  "required": ["dataset_key", "step_code", "status", "runs"],
  "properties": {
    "dataset_key": { "type": "string" },
    "step_code": {
      "type": "string",
      "const": "S7_template_normalization"
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL"]
    },
    "failure_message": { "type": ["string", "null"] },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status", "step_code", "dataset_key",
          "subject", "session", "run_id",
          "metrics", "failure_reasons", "reportlets"
        ],
        "properties": {
          "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
          "step_code": {
            "type": "string",
            "const": "S7_template_normalization"
          },
          "dataset_key": { "type": "string" },
          "subject": { "type": ["string", "null"] },
          "session": { "type": ["string", "null"] },
          "run_id": { "type": ["string", "null"] },
          "anat_to_pam50_init_method": {
            "type": ["string", "null"],
            "enum": ["rootlet", "disc", "auto", null],
            "description": "Method used by S2 for the anat->PAM50 init warp (carried forward from S2 QC)"
          },
          "refinement_enabled": { "type": "boolean" },
          "metrics": {
            "type": "object",
            "properties": {
              "cord_dice_native_func": {
                "type": ["number", "null"],
                "description": "Dice(PAM50_cord warped to func, S5/S6 func cord_dseg) in native func space"
              },
              "label_offset_pam50_mean_mm": {
                "type": ["number", "null"],
                "description": "Mean vertebral-label centroid offset in PAM50 space (subject vs atlas)"
              },
              "label_offset_pam50_max_mm": {
                "type": ["number", "null"]
              },
              "round_trip_func_med_mm": {
                "type": ["number", "null"],
                "description": "Median voxel displacement: funcref -> PAM50 -> funcref"
              },
              "round_trip_func_max_mm": {
                "type": ["number", "null"]
              },
              "runtime_s": { "type": ["number", "null"] }
            }
          },
          "failure_reasons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "failure_message": { "type": ["string", "null"] },
          "reportlets": {
            "type": "object",
            "properties": {
              "pam50_overlay_sagittal": { "type": "string" },
              "pam50_overlay_axial": { "type": "string" },
              "vertebral_alignment": { "type": "string" }
            }
          },
          "xfm_paths": {
            "type": "object",
            "description": "Relative paths to composite warps + provenance",
            "properties": {
              "from_bold_to_PAM50": { "type": "string" },
              "from_PAM50_to_bold": { "type": "string" },
              "sidecar": { "type": "string" }
            }
          },
          "atlas_paths": {
            "type": "object",
            "description": "Native-func PAM50 atlas/mask outputs",
            "properties": {
              "cord_mask": { "type": "string" },
              "csf_mask": { "type": "string" },
              "wm_mask":  { "type": "string" },
              "gm_mask":  { "type": "string" },
              "spinal_levels": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
