# SpinalfMRIprep BIDS-App — production container recipe.
#
# Bundles the neuro-imaging dependencies the pipeline calls (Spinal Cord Toolbox,
# FSL, ANTs) plus the Python package, and exposes the standard BIDS-App
# ENTRYPOINT: `docker run <img> BIDS_DIR OUTPUT_DIR {participant,group}`.
#
# BUILD NOTE: this is a HEAVY image (SCT ~3 GB incl. its bundled ANTs, FSL ~5 GB,
# PAM50 template). The build pulls SCT + FSL installers from the network and takes
# tens of minutes; it is not built in CI sandboxes. Pin the tool versions to match
# the reproducibility receipt before a release build.
#
# Tool roles in the pipeline (so a slimmer image can drop what it doesn't need):
#   SCT  — S2 seg/labeling, S5 SyN, S6/S7 registration, S9 cord smoothing (+ bundled ANTs)
#   FSL  — S5 topup/applytopup (reverse-PE), S8 PNM popp/pnm_evs (RETROICOR)
#   ANTs — S5 SyN (the copy SCT bundles as isct_antsRegistration is sufficient)

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates python3 python3-pip python3-venv \
        bzip2 unzip libgomp1 bc dc \
        gcc g++ make && \
    rm -rf /var/lib/apt/lists/*

# --- Spinal Cord Toolbox (pin to the receipt's sct_version) -----------------
ENV SCT_VERSION=7.1
# install_sct completes the functional install, then runs a self-validation that
# includes GUI ("open a figure with PyQt/matplotlib") checks. These FAIL in a
# headless build (no $DISPLAY) and abort the installer with a non-zero exit, even
# though every functional dependency (PAM50, deepseg models, binaries) installed
# cleanly. We therefore let the installer run, ignore ONLY that cosmetic exit
# code, and instead assert the specific tools the pipeline uses actually work — a
# false GUI-check failure must not fail the build, but a broken SCT must.
RUN git clone --depth 1 --branch ${SCT_VERSION} \
        https://github.com/spinalcordtoolbox/spinalcordtoolbox.git /opt/sct && \
    cd /opt/sct && \
    { yes | ./install_sct -iy || echo "install_sct self-check returned non-zero (headless GUI check); verifying functional deps explicitly"; } && \
    /opt/sct/bin/sct_version && \
    test -d /opt/sct/data/PAM50 && \
    /opt/sct/bin/sct_deepseg_sc -h > /dev/null 2>&1 && \
    /opt/sct/bin/sct_register_multimodal -h > /dev/null 2>&1 && \
    /opt/sct/bin/sct_maths -h > /dev/null 2>&1 && \
    echo "SCT functionally verified"
ENV PATH=/opt/sct/bin:$PATH SCT_DIR=/opt/sct

# --- FSL (topup/applytopup + PNM) -------------------------------------------
# Use FSL's official installer; accept the license non-interactively per FSL ToU.
RUN curl -fsSL https://fsl.fmrib.ox.ac.uk/fsldownloads/fslconda/releases/fslinstaller.py \
        -o /tmp/fslinstaller.py && \
    python3 /tmp/fslinstaller.py -d /opt/fsl -V 6.0.7.9 && rm /tmp/fslinstaller.py
ENV FSLDIR=/opt/fsl PATH=/opt/fsl/bin:$PATH FSLOUTPUTTYPE=NIFTI_GZ

# --- Reportlet rendering deps ------------------------------------------------
# QC reportlets across S2..S10 shell out to ImageMagick (`convert`) for figure
# resize/montage/GIF, and draw banner text with DejaVu fonts. Missing these makes
# every reportlet render fail, which the steps score as a run FAIL.
# (Separate layer to keep the cached SCT/FSL layers; folded into the base apt
# block for release builds.)
RUN apt-get update && apt-get install -y --no-install-recommends \
        imagemagick fonts-dejavu-core && \
    rm -rf /var/lib/apt/lists/*

# --- SpinalfMRIprep package -------------------------------------------------
WORKDIR /app
COPY pyproject.toml README.md /app/
COPY src /app/src
COPY policy /app/policy
COPY schemas /app/schemas
COPY config /app/config
RUN pip3 install --no-cache-dir .

# Standard BIDS-App entrypoint: `docker run <img> BIDS_DIR OUTPUT_DIR LEVEL`.
ENTRYPOINT ["spinalfmriprep"]
